# Talon reads these directly from the process environment (apps/cli,
# apps/talond, apps/desktop) — there's no dotenv loader wired up, so this
# file is a reference, not something auto-loaded. Export the ones you need
# in your shell, or pass them inline:
#   TALON_MODEL=llama3.1:8b pnpm talon

# Project this talond instance/socket belongs to. Defaults to process.cwd()
# if unset — set this explicitly when launching talond/desktop from a
# different working directory than the project you want it to serve.
TALON_PROJECT_ROOT=

# Ollama model tag to use. Defaults to "qwen2.5:7b-instruct" (apps/talond)
# if unset.
TALON_MODEL=

# Unix domain socket path for the talond<->client gRPC transport. Defaults
# to <TALON_PROJECT_ROOT>/.talon/talond.sock if unset.
TALON_SOCKET=

# Path to a YAML file (or directory of them) declaring config-driven tools
# (http/exec/mcp) — see docs/architecture/yaml-tool-config.md. Unset means
# no config-declared tools, only the hand-written builtins.
TALON_TOOLS_CONFIG=

# Path to a flat YAML/JSON secrets file backing {fromSecret} references in
# TALON_TOOLS_CONFIG (docs/architecture/yaml-tool-config.md §7). Unset means
# {fromSecret} is unavailable — only {fromEnv} works.
TALON_SECRETS_FILE=
