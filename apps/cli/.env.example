# apps/cli auto-loads a ".env" file from the *project* it's operating on —
# TALON_PROJECT_ROOT if set, else process.cwd() — via dotenv, before
# resolving anything else from the environment. Copy this file to ".env"
# in that directory to have it picked up automatically (a var already
# exported in your real shell always wins over the file). Running
# `pnpm --filter @talon/cli start` sets cwd to this directory, so a ".env"
# copied right here is what that invocation loads; `pnpm talon` from the
# repo root instead loads the repo root's own ".env" (see its .env.example).
# You can still export things directly instead, or pass them inline:
#   TALON_MODEL=llama3.1:8b pnpm talon
#
# Same vars as the repo-root .env.example — apps/cli, apps/talond, and
# apps/desktop all read this identical set.

# Project this talond instance/socket belongs to. Defaults to process.cwd()
# if unset — set this explicitly when launching talon from a different
# working directory than the project you want it to serve.
TALON_PROJECT_ROOT=

# Ollama model tag talond should use when this CLI auto-starts it. Defaults
# to "qwen2.5:7b-instruct" (apps/talond) if unset.
TALON_MODEL=

# Unix domain socket path for the talond<->client gRPC transport. Defaults
# to <TALON_PROJECT_ROOT>/.talon/talond.sock if unset.
TALON_SOCKET=

# Path to a YAML file (or directory of them) declaring config-driven tools
# (http/exec/mcp) — see docs/architecture/yaml-tool-config.md. Unset means
# no config-declared tools, only the hand-written builtins. Only takes
# effect when this CLI is the one auto-starting talond.
TALON_TOOLS_CONFIG=

# Path to a flat YAML/JSON secrets file backing {fromSecret} references in
# TALON_TOOLS_CONFIG (docs/architecture/yaml-tool-config.md §7). Unset means
# {fromSecret} is unavailable — only {fromEnv} works.
TALON_SECRETS_FILE=

# Only read if TALON_TOOLS_CONFIG enables a "websearch" mcp entry pointing
# at Tavily's MCP server (see packages/agent-tools/examples/tools.example.yaml).
# This CLI forwards its own process env wholesale when auto-starting
# talond, so setting it here before running `talon` is enough — talond's
# {fromEnv: TAVILY_API_KEY} binding picks it up from there. Get a free key
# at https://app.tavily.com.
TAVILY_API_KEY=
