{
  "expo": {
    "name": "Talon",
    "slug": "talon-mobile",
    "scheme": "talon",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.talon.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.talon.mobile",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
