# apps/talond auto-loads a ".env" file from the *project* it's serving —
# TALON_PROJECT_ROOT if set, else process.cwd() — via dotenv, before
# resolving anything else from the environment. Copy this file to ".env"
# in that directory to have it picked up automatically (a var already
# exported in your real shell always wins over the file — including one
# set by whichever of apps/cli/apps/desktop auto-spawned this process).
# Running `pnpm --filter @talon/talond start` sets cwd to this directory,
# so a ".env" copied right here is what that invocation loads. You can
# still export things directly instead, or pass them inline:
#   TALON_MODEL=llama3.1:8b pnpm --filter @talon/talond start
#
# Same vars as the repo-root .env.example — apps/cli, apps/talond, and
# apps/desktop all read this identical set.

# Project this talond instance/socket belongs to. Defaults to process.cwd()
# if unset — set this explicitly when launching talond from a different
# working directory than the project you want it to serve.
TALON_PROJECT_ROOT=

# Ollama model tag to use. Defaults to "qwen2.5:7b-instruct" if unset.
TALON_MODEL=

# How long Ollama keeps this model loaded in memory after a request before
# evicting it ("keep_alive" — a duration like "30m"/"1h", or "-1" for
# indefinitely). Defaults to "30m" if unset. There's no attention KV-cache
# talond can own directly (that lives inside Ollama/llama.cpp's own
# process) — this is the real lever against a full model-reload cost on
# every turn of the same conversation.
TALON_MODEL_KEEP_ALIVE=

# Unix domain socket path talond binds for the gRPC transport. Defaults to
# <TALON_PROJECT_ROOT>/.talon/talond.sock if unset.
TALON_SOCKET=

# Path to a YAML file (or directory of them) declaring config-driven tools
# (http/exec/mcp) — see docs/architecture/yaml-tool-config.md. Unset means
# no config-declared tools, only the hand-written builtins.
TALON_TOOLS_CONFIG=

# Path to a flat YAML/JSON secrets file backing {fromSecret} references in
# TALON_TOOLS_CONFIG (docs/architecture/yaml-tool-config.md §7). Unset means
# {fromSecret} is unavailable — only {fromEnv} works.
TALON_SECRETS_FILE=

# Only read if TALON_TOOLS_CONFIG enables a "websearch" mcp entry pointing
# at Tavily's MCP server (see packages/agent-tools/examples/tools.example.yaml) —
# talond's {fromEnv: TAVILY_API_KEY} binding forwards this into the spawned
# `tavily-mcp` process. Get a free key at https://app.tavily.com.
TAVILY_API_KEY=
